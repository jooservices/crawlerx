{
    "slug": "plum",
    "name": "PLUM",
    "version": "1.0.0",
    "description": "Crawler for PLUM (素人onlyプラム)",
    "author": "JOOservices",
    "requires": {
        "php": ">=8.5",
        "xcrawlerii": "^1.0"
    },
    "adapter": {
        "class": "JOOservices\\CrawlerX\\Adapters\\Plum\\PlumCrawler",
        "capabilities": [
            "listing",
            "detail"
        ]
    },
    "base_url": "https://www.plum-web.com",
    "pagination": {
        "strategy": "path",
        "param": "page"
    },
    "config_schema": [
        {
            "key": "timeout",
            "type": "int",
            "default": 30,
            "tier": "operational",
            "label": "Timeout"
        },
        {
            "key": "page_delay_seconds",
            "type": "int",
            "default": 10,
            "tier": "operational",
            "label": "Page Delay Seconds"
        },
        {
            "key": "detail_delay_seconds",
            "type": "int",
            "default": 6,
            "tier": "operational",
            "label": "Detail Delay Seconds"
        },
        {
            "key": "cycle_delay_seconds",
            "type": "int",
            "default": 3600,
            "tier": "operational",
            "label": "Cycle Delay Seconds"
        }
    ],
    "runtime": {
        "fetch": {
            "profile": "adaptive",
            "readyMarkers": {
                "listing": [
                    "section.content_wrap ul > li"
                ],
                "detail": [
                    "p[itemprop=\"description\"]"
                ]
            },
            "soft404Markers": [
                "page not found",
                "404 not found",
                "the page you requested was not found"
            ]
        },
        "targetProfiles": {
            "new": {
                "label": "Latest releases",
                "url": "https://www.plum-web.com/"
            },
            "series": {
                "label": "Series",
                "url": "https://www.plum-web.com/series/puw/"
            }
        },
        "defaultTargets": [
            {
                "url_type": "new",
                "url": "https://www.plum-web.com/",
                "paginated": false,
                "loop": true,
                "priority": 0,
                "status": "paused"
            },
            {
                "url_type": "series",
                "url": "https://www.plum-web.com/series/puw/",
                "paginated": true,
                "loop": true,
                "priority": 1,
                "max_pages": 3,
                "status": "paused"
            }
        ],
        "fixtureSamples": [
            {
                "url": "https://www.plum-web.com/",
                "name": "listing-home.html",
                "type": "listing"
            },
            {
                "url": "https://www.plum-web.com/series/puw/",
                "name": "listing-series-puw.html",
                "type": "listing"
            },
            {
                "url": "https://www.plum-web.com/title/puw070/",
                "name": "detail-puw070.html",
                "type": "detail"
            }
        ],
        "defaultCrawlConfig": {
            "timeout": 30,
            "page_delay_seconds": 10,
            "detail_delay_seconds": 6,
            "cycle_delay_seconds": 3600
        },
        "defaultThrottle": {
            "default_gap_seconds": 8,
            "min_gap_seconds": 5,
            "max_gap_seconds": 60
        },
        "playwrightFetchEnabled": false,
        "queueSupervisor": {
            "minProcesses": 1,
            "maxProcesses": 3
        }
    },
    "type": "site"
}
