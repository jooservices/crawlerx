{
    "slug": "tma",
    "name": "TMA",
    "version": "1.0.0",
    "description": "TMA (Total Media Agency) product listings and product details",
    "author": "JOOservices",
    "requires": {
        "php": ">=8.5",
        "xcrawlerii": "^1.0"
    },
    "adapter": {
        "class": "JOOservices\\CrawlerX\\Adapters\\Tma\\TmaCrawler",
        "capabilities": [
            "listing",
            "detail"
        ]
    },
    "base_url": "https://www.tma.co.jp",
    "pagination": {
        "strategy": "query",
        "param": "page"
    },
    "config_schema": [
        {
            "key": "timeout",
            "type": "int",
            "default": 30,
            "tier": "operational",
            "label": "Timeout"
        },
        {
            "key": "page_delay_seconds",
            "type": "int",
            "default": 5,
            "tier": "operational",
            "label": "Page Delay Seconds"
        },
        {
            "key": "detail_delay_seconds",
            "type": "int",
            "default": 5,
            "tier": "operational",
            "label": "Detail Delay Seconds"
        },
        {
            "key": "cycle_delay_seconds",
            "type": "int",
            "default": 3600,
            "tier": "operational",
            "label": "Cycle Delay Seconds"
        }
    ],
    "runtime": {
        "fetch": {
            "profile": "adaptive",
            "readyMarkers": {
                "listing": [
                    ".blocklayout .block.product"
                ],
                "detail": [
                    ".product-gallery"
                ]
            },
            "soft404Markers": [
                "page not found"
            ]
        },
        "targetProfiles": {
            "tma_products": {
                "label": "All TMA products",
                "url": "https://www.tma.co.jp/collections/tma"
            }
        },
        "defaultTargets": [
            {
                "url_type": "listing",
                "url": "https://www.tma.co.jp/collections/tma",
                "paginated": true,
                "loop": true,
                "priority": 0,
                "status": "paused"
            }
        ],
        "fixtureSamples": [
            {
                "url": "https://www.tma.co.jp/collections/tma",
                "name": "listing-page1.html",
                "type": "listing"
            },
            {
                "url": "https://www.tma.co.jp/collections/tma?page=2",
                "name": "listing-page2.html",
                "type": "listing"
            },
            {
                "url": "https://www.tma.co.jp/products/t38-073",
                "name": "detail-t38-073.html",
                "type": "detail"
            }
        ],
        "defaultCrawlConfig": {
            "timeout": 30,
            "page_delay_seconds": 5,
            "detail_delay_seconds": 5,
            "cycle_delay_seconds": 3600
        },
        "defaultThrottle": {
            "default_gap_seconds": 5,
            "min_gap_seconds": 5,
            "max_gap_seconds": 45
        },
        "playwrightFetchEnabled": false
    },
    "type": "site"
}
