{
    "slug": "yuira",
    "name": "YUIRA",
    "version": "1.0.0",
    "description": "Official YUIRA product listing and product details",
    "author": "JOOservices",
    "requires": {
        "php": ">=8.5",
        "xcrawlerii": "^1.0"
    },
    "adapter": {
        "class": "JOOservices\\CrawlerX\\Adapters\\Yuira\\YuiraCrawler",
        "capabilities": [
            "listing",
            "detail"
        ]
    },
    "base_url": "https://yuira.jp",
    "pagination": {
        "strategy": "query",
        "param": "product-page"
    },
    "config_schema": [
        {
            "key": "timeout",
            "type": "int",
            "default": 30,
            "tier": "operational",
            "label": "Timeout"
        },
        {
            "key": "page_delay_seconds",
            "type": "int",
            "default": 5,
            "tier": "operational",
            "label": "Page Delay Seconds"
        },
        {
            "key": "detail_delay_seconds",
            "type": "int",
            "default": 5,
            "tier": "operational",
            "label": "Detail Delay Seconds"
        },
        {
            "key": "cycle_delay_seconds",
            "type": "int",
            "default": 3600,
            "tier": "operational",
            "label": "Cycle Delay Seconds"
        }
    ],
    "runtime": {
        "fetch": {
            "profile": "adaptive",
            "readyMarkers": {
                "listing": [
                    "ul.products > li.product"
                ],
                "detail": [
                    "h2.product_title"
                ]
            },
            "soft404Markers": [
                "page not found",
                "404 not found",
                "the page you requested was not found"
            ]
        },
        "targetProfiles": {
            "all_products": {
                "label": "All YUIRA products",
                "url": "https://yuira.jp/allproduct/?orderby=date"
            }
        },
        "defaultTargets": [
            {
                "url_type": "listing",
                "url": "https://yuira.jp/allproduct/?orderby=date",
                "paginated": true,
                "loop": true,
                "priority": 0,
                "status": "paused"
            }
        ],
        "fixtureSamples": [
            {
                "url": "https://yuira.jp/allproduct/?orderby=date",
                "name": "listing-page1.html",
                "type": "listing",
                "followUps": [
                    {
                        "url": "https://yuira.jp/allproduct/?orderby=date&product-page=2",
                        "name": "listing-page2.html"
                    }
                ]
            },
            {
                "url": "https://yuira.jp/allproduct/?orderby=date&product-page=2",
                "name": "listing-page2.html",
                "type": "listing"
            },
            {
                "url": "https://yuira.jp/product/%e3%81%bc%e3%81%8f%e3%81%a8%e5%85%ab%e5%b0%ba%e6%a7%98%e3%80%80%e3%81%bd%e3%81%bd%e3%81%a3%e3%81%a8%e3%81%88%e3%81%a3%e3%81%a1%e3%81%aa%e3%83%87%e3%82%ab%e5%b0%bb%e3%81%ab%e5%ad%95%e3%81%be%e3%81%9b/",
                "name": "detail-gods-921.html",
                "type": "detail"
            }
        ],
        "defaultCrawlConfig": {
            "timeout": 30,
            "page_delay_seconds": 5,
            "detail_delay_seconds": 5,
            "cycle_delay_seconds": 3600
        },
        "defaultThrottle": {
            "default_gap_seconds": 5,
            "min_gap_seconds": 5,
            "max_gap_seconds": 45
        },
        "playwrightFetchEnabled": false
    },
    "type": "site"
}
