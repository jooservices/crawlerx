# CrawlerX configuration. Copy to .env; real environment variables always win. Never commit .env.
#
# Where the browser service and FlareSolverr run is only a matter of these addresses.
# Workspaces default: the Dev VM services reached through the tunnels
#   scripts/docker/playwright-fetch-vm up   and   scripts/docker/flaresolverr-vm up
# (from a container the host is host.docker.internal; from the Mac itself use 127.0.0.1).
PLAYWRIGHT_URL=http://host.docker.internal:3000
FLARESOLVERR_URL=http://host.docker.internal:8191/v1

# Own Docker instead (make fetch-up): use these values.
# PLAYWRIGHT_URL=http://node:3000
# FLARESOLVERR_URL=http://flaresolverr:8191/v1

# How `make` runs PHP. Empty = the project's own Docker (docker compose run --rm php).
# Workspaces shared runtime (no quotes, path relative to this project):
# CRAWLERX_PHP=../../../scripts/docker/runtime php@8.5
CRAWLERX_PHP=

# Optional fetch tuning
# CRAWLERX_USER_AGENT=
# CRAWLERX_USER_AGENT_POOL=
# CRAWLERX_NODE=

# Browser service tuning (read by scripts/fetch-server.mjs)
# PLAYWRIGHT_HOST=127.0.0.1        bind address (default 0.0.0.0 for containers)
# PLAYWRIGHT_PORT=3000
# CRAWLERX_BROWSER_ALLOWED_HOSTS=

# Owner-provided login cookies for manual live canary runs only.
# Never commit real cookie values.
CRAWLERX_COOKIE_AVFAN=
CRAWLERX_COOKIE_AVFAN_PROFILES=
