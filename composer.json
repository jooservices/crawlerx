{
    "name": "jooservices/crawlerx",
    "description": "URL-driven crawl and parse library for JAV catalog sites.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.5",
        "ext-dom": "*",
        "ext-libxml": "*",
        "jooservices/client": "^4.0",
        "jooservices/dto": "^3.0",
        "nyholm/psr7": "^1.8",
        "psr/http-message": "^2.0",
        "symfony/css-selector": "^7.0 || ^8.0",
        "symfony/dom-crawler": "^7.0"
    },
    "require-dev": {
        "captainhook/captainhook": "^5.23",
        "captainhook/plugin-composer": "^5.3",
        "friendsofphp/php-cs-fixer": "^3.65",
        "laravel/pint": "^1.18",
        "phpmd/phpmd": "^2.15",
        "phpstan/phpstan": "^2.1",
        "phpstan/phpstan-phpunit": "^2.0",
        "phpstan/phpstan-strict-rules": "^2.0",
        "phpunit/phpunit": "^13.0",
        "squizlabs/php_codesniffer": "^3.12 || ^4.0"
    },
    "autoload": {
        "psr-4": {
            "JOOservices\\CrawlerX\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "JOOservices\\CrawlerX\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit --no-coverage",
        "test:unit": "phpunit --no-coverage --testsuite Unit",
        "test:feature": "phpunit --no-coverage --testsuite Feature",
        "test:coverage": "mkdir -p build/coverage && phpunit --coverage-clover build/coverage/clover-Unit.xml --testsuite Unit && phpunit --coverage-clover build/coverage/clover-Feature.xml --testsuite Feature",
        "coverage:check": [
            "php tools/coverage-enforce.php build/coverage/clover-Unit.xml",
            "php tools/coverage-enforce.php build/coverage/clover-Feature.xml",
            "php tools/coverage-merge.php"
        ],
        "lint:pint": "pint --test",
        "lint:pint:fix": "pint",
        "lint:phpcs": "phpcs --standard=phpcs.xml",
        "lint:phpstan": "XDEBUG_MODE=off phpstan analyse --configuration=phpstan.neon --memory-limit=512M",
        "lint:phpmd": "php -d error_reporting=6143 vendor/bin/phpmd src text phpmd.xml",
        "lint:cs": "php-cs-fixer fix --config=.php-cs-fixer.dist.php --dry-run --diff --sequential",
        "lint:cs:fix": "php-cs-fixer fix --config=.php-cs-fixer.dist.php --sequential",
        "lint": ["@lint:pint", "@lint:phpcs", "@lint:phpstan", "@lint:phpmd", "@lint:cs"],
        "lint:fix": ["@lint:pint:fix", "@lint:cs:fix"],
        "check": ["@lint", "@test"],
        "ci": ["@lint", "@test:coverage", "@coverage:check"],
        "hooks:install": "captainhook install --force --skip-existing",
        "post-install-cmd": "captainhook install --force --skip-existing",
        "post-update-cmd": "captainhook install --force --skip-existing"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "captainhook/plugin-composer": true
        },
        "audit": {"abandoned": "ignore"}
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
