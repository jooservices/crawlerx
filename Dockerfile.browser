# syntax=docker/dockerfile:1

FROM node:22-bookworm-slim@sha256:43ac6c60b8f89723f746e8a92ce91abd5017e627ce1ddfe4238355d3a30b772c AS dependencies

WORKDIR /app
ENV PLAYWRIGHT_BROWSERS_PATH=/ms-playwright

COPY package.json package-lock.json ./

RUN --mount=type=cache,target=/root/.npm,sharing=locked \
    npm ci --ignore-scripts \
    && npx playwright install --with-deps chromium

FROM node:22-bookworm-slim@sha256:43ac6c60b8f89723f746e8a92ce91abd5017e627ce1ddfe4238355d3a30b772c AS runtime

ARG CRAWLERX_VERSION=dev

ENV NODE_ENV=production \
    PLAYWRIGHT_BROWSERS_PATH=/ms-playwright \
    CRAWLERX_VERSION=${CRAWLERX_VERSION}

WORKDIR /app

COPY --from=dependencies --chown=node:node /app/node_modules ./node_modules
COPY --from=dependencies --chown=node:node /ms-playwright /ms-playwright

RUN npx playwright install-deps chromium \
    && rm -rf /var/lib/apt/lists/*

COPY --chown=node:node scripts/fetch-server.mjs scripts/playwright-fetch.mjs scripts/puppeteer-stealth-fetch.mjs scripts/ssrf-guard.mjs scripts/ssrf-proxy.mjs ./scripts/

USER node

EXPOSE 3000

HEALTHCHECK --interval=10s --timeout=5s --start-period=30s --retries=12 \
    CMD node -e "fetch('http://127.0.0.1:3000/health').then((response) => process.exit(response.ok ? 0 : 1)).catch(() => process.exit(1))"

CMD ["node", "scripts/fetch-server.mjs"]
