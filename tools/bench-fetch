#!/usr/bin/env php
<?php

declare(strict_types=1);

use JOOservices\Client\Client\ClientBuilder;
use JOOservices\Client\Testing\TestResponse;
use JOOservices\Client\Testing\TestResponseSequence;
use JOOservices\CrawlerX\CrawlerX;
use JOOservices\CrawlerX\CrawlerXFactory;
use JOOservices\CrawlerX\Enums\CrawlType;
use JOOservices\CrawlerX\Enums\FetchMethod;
use JOOservices\CrawlerX\Fetch\FetchPlanResolver;
use JOOservices\CrawlerX\Fetch\FetchFallbackChain;
use JOOservices\CrawlerX\Fetch\Guard\HostThrottle;
use JOOservices\CrawlerX\Fetch\Handlers\HttpFetchHandler;
use JOOservices\CrawlerX\Fetch\Session\CookieHandoffStore;
use JOOservices\CrawlerX\Registry\AdapterRegistry;
use JOOservices\CrawlerX\Registry\FileAdapterManifestRegistry;
use JOOservices\CrawlerX\Services\AdapterExecutor;
use JOOservices\CrawlerX\Services\ClientFactory;
use JOOservices\CrawlerX\Services\CrawlOrchestrator;
use JOOservices\CrawlerX\Services\CrawlerXService;
use JOOservices\CrawlerX\Services\UrlClassifier;
use JOOservices\CrawlerX\Tools\Bench\RepeatedFollowUpCrawler;

require dirname(__DIR__) . '/vendor/autoload.php';
require_once __DIR__ . '/bench/RepeatedFollowUpCrawler.php';

$options = getopt('', ['site::', 'sample::', 'repeat-follow-up', 'memo::', 'help']);
if (isset($options['help'])) {
    fwrite(STDOUT, "Usage: tools/bench-fetch [--site=slug] [--sample=fixture-name] [--repeat-follow-up [--memo=on|off]]\n");
    fwrite(STDOUT, "Defaults to the Smart FLASH gallery fixture. All HTTP responses are faked from tests/Fixtures.\n");
    fwrite(STDOUT, "The repeat mode crawls a gallery fixture and reads its first follow-up twice.\n");
    exit(0);
}

$site = is_string($options['site'] ?? null) ? $options['site'] : 'smartflash';
$sampleName = is_string($options['sample'] ?? null) ? $options['sample'] : 'gallery-432913.html';
$repeatFollowUp = isset($options['repeat-follow-up']);
$memo = is_string($options['memo'] ?? null) ? strtolower($options['memo']) : 'on';
if (! in_array($memo, ['on', 'off'], true) || (! $repeatFollowUp && isset($options['memo']))) {
    throw new RuntimeException('--memo=on|off is only valid with --repeat-follow-up.');
}
$root = dirname(__DIR__);
$manifest = null;
foreach (glob($root . '/src/Adapters/*/manifest.json') ?: [] as $manifestPath) {
    $candidate = json_decode((string) file_get_contents($manifestPath), true, flags: JSON_THROW_ON_ERROR);
    if (is_array($candidate) && ($candidate['slug'] ?? null) === $site) {
        $manifest = $candidate;
        break;
    }
}
if (! is_array($manifest)) {
    throw new RuntimeException("Adapter manifest not found for site [{$site}].");
}

$samples = $manifest['runtime']['fixtureSamples'] ?? [];
if (! is_array($samples)) {
    throw new RuntimeException("Fixture samples are invalid for site [{$site}].");
}

$sample = null;
foreach ($samples as $candidate) {
    if (is_array($candidate) && ($candidate['name'] ?? null) === $sampleName) {
        $sample = $candidate;
        break;
    }
}
if (! is_array($sample) || ! is_string($sample['url'] ?? null) || ! is_string($sample['type'] ?? null)) {
    throw new RuntimeException("Fixture sample [{$sampleName}] not found for site [{$site}].");
}

$followUpUrl = null;
if ($repeatFollowUp) {
    if ($sample['type'] !== 'gallery' || ! is_array($sample['followUps'] ?? null)) {
        throw new RuntimeException("Sample [{$sampleName}] must be a gallery with a declared follow-up.");
    }

    $followUp = $sample['followUps'][0] ?? null;
    if (! is_array($followUp) || ! is_string($followUp['url'] ?? null)) {
        throw new RuntimeException("Sample [{$sampleName}] has no usable follow-up URL.");
    }
    $followUpUrl = $followUp['url'];
}

$crawlType = match ($sample['type']) {
    'listing' => CrawlType::Listing,
    'detail' => CrawlType::Detail,
    'gallery' => CrawlType::Gallery,
    'performer_listing' => CrawlType::PerformerListing,
    'performer_detail' => CrawlType::PerformerDetail,
    'performer_search' => CrawlType::PerformerSearch,
    'search' => CrawlType::Search,
    default => throw new RuntimeException("Fixture sample [{$sampleName}] is not crawlable."),
};

$fixtureFolder = match ($site) {
    'aisex' => 'Aisex',
    'avfan' => 'Avfan',
    'avfan_profiles' => 'AvfanProfiles',
    'avjoho' => 'avjoho',
    'javlibrary' => 'JavLibrary',
    default => $site,
};
$fixtures = [];
$registerFixture = static function (string $url, string $name) use (&$fixtures, $root, $fixtureFolder): void {
    $path = $root . '/tests/Fixtures/' . $fixtureFolder . '/' . ltrim($name, '/');
    if (! is_file($path)) {
        throw new RuntimeException("Fixture file not found: {$path}");
    }

    $fixtures[$url] = (string) file_get_contents($path);
};

$registerFixture($sample['url'], $sample['name']);
foreach ($sample['followUps'] ?? [] as $followUp) {
    if (is_array($followUp) && is_string($followUp['url'] ?? null) && is_string($followUp['name'] ?? null)) {
        $registerFixture($followUp['url'], $followUp['name']);
    }
}
foreach ($samples as $supporting) {
    if (
        is_array($supporting)
        && in_array($supporting['type'] ?? null, ['supporting', 'taxonomy'], true)
        && is_string($supporting['url'] ?? null)
        && is_string($supporting['name'] ?? null)
    ) {
        $registerFixture($supporting['url'], $supporting['name']);
    }
}

ClientBuilder::fake();
foreach ($fixtures as $url => $body) {
    $responses = new TestResponseSequence();
    for ($attempt = 0; $attempt < 5; $attempt++) {
        $responses->push(TestResponse::make(200, ['Content-Type' => 'text/html; charset=utf-8'], $body));
    }
    ClientBuilder::respond('GET', $url, $responses);
}

CrawlerXFactory::reset();
$clientFactory = new ClientFactory();
$httpHandler = new HttpFetchHandler($clientFactory, new CookieHandoffStore());
$fetchChain = new FetchFallbackChain(
    [FetchMethod::Http->value => $httpHandler],
    hostThrottle: new HostThrottle(sleeper: static function (int $microseconds): void {
        // Fake responses should measure local crawl work, not site throttle delays.
    }),
    maxTransientRetries: 0,
);

if ($repeatFollowUp) {
    RepeatedFollowUpCrawler::$followUpUrl = $followUpUrl;
    RepeatedFollowUpCrawler::$memoEnabled = $memo === 'on';
    $manifests = new FileAdapterManifestRegistry();
    $adapters = new AdapterRegistry($clientFactory, $manifests);
    $adapters->register($site, RepeatedFollowUpCrawler::class);
    $orchestrator = new CrawlOrchestrator(
        new UrlClassifier($adapters),
        new CrawlerXService($adapters, new AdapterExecutor()),
        $manifests,
        new FetchPlanResolver(),
        $fetchChain,
    );
    $crawl = static fn() => $orchestrator->url($sample['url'])->site($site)->type($crawlType)->crawl();
} else {
    CrawlerXFactory::useFetchChain($fetchChain);
    $crawl = static fn() => CrawlerX::url($sample['url'])->site($site)->type($crawlType)->crawl();
}

$startedAt = hrtime(true);
try {
    $crawl();
    $wallTimeMs = (hrtime(true) - $startedAt) / 1_000_000;
    $recorded = ClientBuilder::recorded();
    $requests = [];
    $bytes = 0;
    foreach ($recorded as $record) {
        $url = (string) $record->request->getUri();
        if (! isset($fixtures[$url])) {
            throw new RuntimeException("Crawl requested a URL without a registered fixture: {$url}");
        }
        $requests[] = $url;
        $bytes += strlen($fixtures[$url]);
    }

    fwrite(STDOUT, json_encode([
        'site' => $site,
        'sample' => $sampleName,
        'requests' => count($requests),
        'response_bytes' => $bytes,
        'wall_time_ms' => round($wallTimeMs, 2),
        'repeat_follow_up' => $repeatFollowUp,
        'memoization' => $repeatFollowUp ? $memo : null,
        'transport' => 'fixture fakes; throttle sleeps disabled',
        'request_urls' => $requests,
    ], JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES | JSON_THROW_ON_ERROR) . "\n");
} catch (Throwable $exception) {
    fwrite(STDERR, $exception->getMessage() . "\n");
    exit(1);
} finally {
    ClientBuilder::clearFake();
    CrawlerXFactory::reset();
    RepeatedFollowUpCrawler::$followUpUrl = '';
    RepeatedFollowUpCrawler::$memoEnabled = true;
}
