#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
cd "$ROOT"

docker compose run --rm --no-deps php vendor/bin/captainhook install --force --skip-existing

HOOKS_DIR="$(git rev-parse --git-path hooks)"
for hook in "$HOOKS_DIR"/*; do
    if [ -f "$hook" ] && grep -q 'vendor/bin/captainhook' "$hook" 2>/dev/null; then
        sed -i '' 's|vendor/bin/captainhook|tools/run-captainhook|g' "$hook"
    fi
done

echo "Git hooks installed (CaptainHook via Docker: tools/run-captainhook)"
